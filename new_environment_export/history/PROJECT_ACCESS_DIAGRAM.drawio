<mxfile host="app.diagrams.net" modified="2026-07-07T00:00:00.000Z" agent="claude" version="24.0.0">
  <diagram id="project-access" name="Project-Based Meeting Access">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="Project-Based Meeting Access — Architecture &amp; Flows" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- ================= CLIENT ================= -->
        <mxCell id="frontend" value="Frontend (Browser)&#10;SyntheraAI / LMA UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Amazon Cognito&#10;(Entra ID federated)&#10;→ ctx.identity.username" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="200" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- ================= APPSYNC ================= -->
        <mxCell id="appsync" value="AWS AppSync — LMA GraphQL API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="70" width="580" height="360" as="geometry" />
        </mxCell>
        <mxCell id="getuserprojects" value="Function: GetUserProjects&#10;(step 1 of every read)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="120" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="readresolvers" value="Read resolvers&#10;getCall · getTranscriptSegments&#10;listCalls / listCallsDateShard / …" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="185" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="addsegment" value="addTranscriptSegment (D.8)&#10;copies ProjectId + ExcludedUsers&#10;from c# onto each new line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="250" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subs" value="Subscriptions (live)&#10;onAddTranscriptSegment, onCreateCall…&#10;filter: Owner OR SharedWith OR ProjectId∈mine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="195" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="ACCESS RULE (all read paths)&#10;Allow if:  Owner  OR  SharedWith contains me&#10;OR ( ProjectId ∈ myProjects  AND  me ∉ ExcludedUsers )" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="290" width="520" height="70" as="geometry" />
        </mxCell>

        <!-- ================= DYNAMODB ================= -->
        <mxCell id="mirror" value="Access Mirror — DynamoDB (NEW)&#10;&#10;PK: u#&lt;cognitoUsername&gt;&#10;ProjectIds: [ proj_A, proj_B ]" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lmatable" value="LMA EventSourcing Table — DynamoDB&#10;&#10;c#&lt;CallId&gt;  ← ProjectId, ExcludedUsers, SharedWith, Owner&#10;cls#&lt;date&gt;#s#… (list)  ← ProjectId, ExcludedUsers&#10;trs#&lt;CallId&gt; / s#… (transcript lines)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="480" width="380" height="150" as="geometry" />
        </mxCell>

        <!-- ================= YOUR BACKEND (SYNTHERA) ================= -->
        <mxCell id="zone" value="Your Synthera app (source of truth)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#82b366;dashed=1;verticalAlign=top;fontColor=#2d6a2d;fontStyle=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1120" y="70" width="300" height="620" as="geometry" />
        </mxCell>
        <mxCell id="mongo" value="MongoDB&#10;projects · members&#10;meeting ↔ LMA CallId" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="220" height="110" as="geometry" />
        </mxCell>
        <mxCell id="synclambda" value="MongoDB Change Stream&#10;→ Sync Lambda (D.9)&#10;writes access-mirror rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="270" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="restapi" value="Synthera REST API backend&#10;direct SDK writes:&#10;ProjectId / ExcludedUsers on c#,cls#&#10;(link &amp; block)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="400" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="vpjoin" value="VP-join Stream Lambda&#10;on Virtual Participant join:&#10;record CallId, trigger link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1160" y="540" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- ================= EDGES ================= -->
        <mxCell id="e1" value="query / subscribe&#10;(Cognito token)" style="endArrow=block;html=1;fontSize=10;rounded=0;" edge="1" parent="1" source="frontend" target="appsync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="login" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="frontend" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="validated identity" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="cognito" target="appsync">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="step 1" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="readresolvers" target="getuserprojects">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="GetItem: my ProjectIds" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="getuserprojects" target="mirror">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="query c# / cls# / trs#&#10;then apply rule" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="readresolvers" target="lmatable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="read c# ProjectId,&#10;put stamped segment" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="addsegment" target="lmatable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="push new lines&#10;to allowed users" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="subs" target="frontend">
          <mxGeometry relative="1" as="geometry" />
          <Array as="points"><mxPoint x="470" y="40" /></Array>
        </mxCell>
        <mxCell id="e9" value="membership change" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="mongo" target="synclambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="write u# row&#10;(ProjectIds)" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="synclambda" target="mirror">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="write ProjectId / ExcludedUsers&#10;on c#, cls#" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="restapi" target="lmatable">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="on VP join: link meeting→project" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="vpjoin" target="restapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="record CallId ↔ meeting" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="vpjoin" target="mongo">
          <mxGeometry relative="1" as="geometry" />
          <Array as="points"><mxPoint x="1410" y="585" /><mxPoint x="1410" y="165" /></Array>
        </mxCell>

