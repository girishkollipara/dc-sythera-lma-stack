{
 "Version": "2012-10-17",
 "Statement": [
  {
   "Action": [
    "ecs:RunTask"
   ],
   "Resource": [
    "arn:aws:ecs:us-east-1:528757797189:task-definition/LMASA-VIRTUALPARTICIPANTSTACK-1IAVIZT1439R2VirtualParticipantTaskDef:3",
    "arn:aws:ecs:us-east-1:528757797189:task-definition/LMASA-VIRTUALPARTICIPANTSTACK-1IAVIZT1439R2VirtualParticipantTaskDef:3:*"
   ],
   "Effect": "Allow"
  },
  {
   "Condition": {
    "StringEquals": {
     "ecs:CreateAction": "RunTask"
    }
   },
   "Action": [
    "ecs:TagResource"
   ],
   "Resource": "*",
   "Effect": "Allow"
  },
  {
   "Condition": {
    "StringLike": {
     "iam:PassedToService": "ecs-tasks.amazonaws.com"
    }
   },
   "Action": [
    "iam:PassRole"
   ],
   "Resource": "*",
   "Effect": "Allow"
  }
 ]
}