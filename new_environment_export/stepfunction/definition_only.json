   "Next": "Map"
  },
  "Map": {
   "Type": "Map",
   "ItemProcessor": {
    "ProcessorConfig": {
     "Mode": "INLINE"
    },
    "StartAt": "GetSchedule",
    "States": {
     "GetSchedule": {
      "Type": "Task",
      "End": true,
      "Parameters": {
       "GroupName.$": "$.GroupName",
       "Name.$": "$.Name"
      },
      "Resource": "arn:aws:states:::aws-sdk:scheduler:getSchedule",
      "ResultSelector": {
       "CreationDate.$": "$.CreationDate",
       "Description.$": "$.Description",
       "GroupName.$": "$.GroupName",
       "Name.$": "$.Name",
       "ScheduleExpression.$": "$.ScheduleExpression",
       "ScheduleExpressionTimezone.$": "$.ScheduleExpressionTimezone"
      }
     }
    }
   },
   "End": true,
   "ItemsPath": "$.Schedules"
  },
  "DeleteSchedule": {
