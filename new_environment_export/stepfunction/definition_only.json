    "LaunchType": "FARGATE",
    "NetworkConfiguration": {
     "AwsvpcConfiguration": {
      "AssignPublicIp": "DISABLED",
      "SecurityGroups": [
       "sg-0fce20b5b14d24cd8"
      ],
      "Subnets": [
       "subnet-035b862c6058f28f2",
       "subnet-00ab6bb3680d64d68"
      ]
     }
    },
    "Overrides": {
     "ContainerOverrides": [
      {
       "Name": "scribe",
       "Environment": [
        {
         "Name": "MEETING_PLATFORM",
         "Value.$": "$.data.meetingPlatform"
        },
        {
         "Name": "MEETING_ID",
         "Value.$": "$.data.meetingID"
        },
        {
         "Name": "MEETING_PASSWORD",
         "Value.$": "$.data.meetingPassword"
        },
        {
