      "TaskCount": 1,
      "TaskDefinitionArn": "arn:aws:ecs:us-east-1:528757797189:task-definition/LMASA-VIRTUALPARTICIPANTSTACK-1IAVIZT1439R2VirtualParticipantTaskDef:4"
     },
     "Input": {
      "containerOverrides": [
       {
        "name": "scribe",
        "environment": [
         {
          "name": "MEETING_PLATFORM",
          "value.$": "$.data.meetingPlatform"
         },
         {
          "name": "MEETING_ID",
          "value.$": "$.data.meetingID"
         },
         {
          "name": "MEETING_PASSWORD",
          "value.$": "$.data.meetingPassword"
